{
    "name": "laboiteacode/monitor-php",
    "description": "Framework-agnostic PHP core for Quiet Guard clients (Laravel, Symfony, WordPress).",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "monitoring",
        "error-tracking",
        "exceptions",
        "logging",
        "php"
    ],
    "authors": [
        {
            "name": "La boite a code",
            "email": "alexandre@laboiteacode.fr"
        }
    ],
    "homepage": "https://github.com/La-boite-a-code/Quiet Guard",
    "support": {
        "issues": "https://github.com/La-boite-a-code/Quiet Guard/issues",
        "source": "https://github.com/La-boite-a-code/Quiet Guard"
    },
    "require": {
        "php": "^8.2",
        "ext-sodium": "*",
        "ext-curl": "*",
        "psr/log": "^1.0 || ^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "LaBoiteACode\\Monitor\\": "src/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
